// secrets.h.example - Configuration template for ESP32-C6 Secure OTA
// Copy this file to 'secrets.h' and fill in your actual credentials.
// NOTE: secrets.h is ignored by git to prevent committing sensitive keys/credentials.

#pragma once

// Wi-Fi Credentials
#define WIFI_SSID         "YOUR_WIFI_SSID"
#define WIFI_PASSWORD     "YOUR_WIFI_PASSWORD"

// OTA Server Configuration
// Enter your Laptop/Host IP address running the OTA server
#define OTA_SERVER_HOST   "192.168.1.100"
#define OTA_SERVER_PORT   8443

// Device Identity
#define DEVICE_ID         "ESP32C6-SMARTELEX-01"

// Security Mode Toggles
#define ENABLE_MTLS       false   // Set true to enable Mutual TLS client certificate auth

// Current Firmware State
#define FIRMWARE_VERSION  "1.0.0"
#define SEQUENCE_NUMBER   1       // Monotonic sequence number (Anti-rollback tracking)

// Demo & Attack Simulation Flags
// Set to true when building the "Signed but Buggy V2" build to trigger health-check rollback (Test 5)
#define SIMULATE_BUGGY_V2 false

